{
  "functions": {
    "api/ai-doctor-chat.ts": {
      "maxDuration": 60,
      "includeFiles": "{api/_lib/research/model/**,api/_lib/research/library-embeddings.json,api/_lib/research/fulltext-chunks.json,api/_lib/research/fulltext-index.json,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm}",
      "excludeFiles": "node_modules/onnxruntime-web/dist/{*.map,ort.all*,ort.webgl*,ort.webgpu*,ort.jspi*,ort.wasm*,ort.bundle*,ort.min.*,ort.js,ort.mjs,*.jsep.*,*.asyncify.*,*.jspi.*}"
    },
    "api/router.ts": {
      "includeFiles": "{api/_lib/research/model/**,api/_lib/research/library-embeddings.json,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm}",
      "excludeFiles": "node_modules/onnxruntime-web/dist/{*.map,ort.all*,ort.webgl*,ort.webgpu*,ort.jspi*,ort.wasm*,ort.bundle*,ort.min.*,ort.js,ort.mjs,*.jsep.*,*.asyncify.*,*.jspi.*}"
    }
  },
  "rewrites": [
    { "source": "/api/:path((?!router$).*)", "destination": "/api/router?__route=:path" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
