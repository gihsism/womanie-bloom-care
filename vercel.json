{
  "functions": {
    "api/ai-doctor-chat.ts": {
      "maxDuration": 60,
      "includeFiles": "{api/_lib/research/{model/**,library-embeddings.json,fulltext-chunks.json,fulltext-index.json},node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{mjs,wasm}}",
      "excludeFiles": "node_modules/onnxruntime-web/dist/{*.map,ort.all*,ort.webgl*,ort.webgpu*,ort.jspi*,ort.wasm*,ort.bundle*,ort.min.*,ort.js,ort.mjs,*.jsep.*,*.asyncify.*,*.jspi.*}"
    },
    "api/router.ts": {
      "includeFiles": "{api/_lib/research/model/**,api/_lib/research/library-embeddings.json,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs,node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm}",
      "excludeFiles": "node_modules/onnxruntime-web/dist/{*.map,ort.all*,ort.webgl*,ort.webgpu*,ort.jspi*,ort.wasm*,ort.bundle*,ort.min.*,ort.js,ort.mjs,*.jsep.*,*.asyncify.*,*.jspi.*}"
    }
  },
  "rewrites": [
    { "source": "/api/:path((?!router$).*)", "destination": "/api/router?__route=:path" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-Gv2vN7Dp722KtCyYFA4iv/HU5mdu4CIjDDmWsQjHm2o='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.sentry.io https://vercel.com https://*.blob.vercel-storage.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' blob: https://*.blob.vercel-storage.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
